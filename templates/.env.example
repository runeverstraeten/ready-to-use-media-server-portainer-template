# ============================================================

# Ready-to-use Media Server

# Environment Variables

# ============================================================

#

# Copy this file to ".env" and change the values where needed.

#

# Linux / NAS example:

# cp .env.example .env

#

# Docker Desktop:

# Copy this file to .env manually.

#

# IMPORTANT:

# Never commit your real .env file to GitHub.

# ============================================================

# ============================================================

# GENERAL

# ============================================================

# Timezone used by all containers

# List of timezones:

# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

TZ=Europe/Brussels

# Linux User ID

# Find with: id

PUID=1000

# Linux Group ID

# Find with: id

PGID=1000

# ============================================================

# STORAGE

# ============================================================

# Directory containing application configuration files.

#

# Linux / NAS example:

# APPDATA_DIR=/DATA/AppData

#

# Docker Desktop Windows example:

# APPDATA_DIR=C:/Docker/AppData

#

# Docker Desktop macOS example:

# APPDATA_DIR=/Users/username/Docker/AppData

APPDATA_DIR=/DATA/AppData

# Main media directory.

#

# Example:

# MEDIA_DIR=/mnt/media_storage/Media

#

# Windows example:

# MEDIA_DIR=D:/Media

#

# macOS example:

# MEDIA_DIR=/Volumes/Media/Media

MEDIA_DIR=/mnt/media_storage/Media

# Root data directory used by Transmission, Sonarr and Radarr.

#

# Keeping downloads and media on the same filesystem allows

# Sonarr/Radarr to use hardlinks instead of copying files.

DATA_DIR=/DATA

# ============================================================

# JELLYSTAT / POSTGRESQL

# ============================================================

# PostgreSQL username used by Jellystat

POSTGRES_USER=postgres

# IMPORTANT:

# Change this to a strong, unique password.

#

# Do NOT use the example password in a production installation.

POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Secret used by Jellystat for JWT authentication.

#

# Generate a long random string.

#

# Example only:

# JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ============================================================

# PLEX

# ============================================================

# Plex Claim Token

#

# Generate a fresh token at:

# https://www.plex.tv/claim/

#

# The token is temporary and should be generated immediately

# before deploying the Plex container.

PLEX_CLAIM=

# ============================================================

# OPTIONAL

# ============================================================

# If you do not want to use a custom Plex Claim Token during

# deployment, leave PLEX_CLAIM empty and configure Plex manually

# after the container has started.

# ============================================================

# EXAMPLE CONFIGURATION

# ============================================================

#

# A typical Linux configuration would look like:

#

# TZ=Europe/Brussels

# PUID=1000

# PGID=1000

#

# APPDATA_DIR=/DATA/AppData

# MEDIA_DIR=/mnt/media_storage/Media

# DATA_DIR=/DATA

#

# POSTGRES_USER=postgres

# POSTGRES_PASSWORD=MyVeryStrongPassword

# JWT_SECRET=some-long-random-secret

# PLEX_CLAIM=claim-xxxxxxxxxxxxxxxx

#

# ============================================================

# SECURITY

# ============================================================

#

# NEVER upload your real ".env" file to GitHub.

#

# Your .env may contain:

# - PostgreSQL passwords

# - JWT secrets

# - Plex claim tokens

# - API keys

#

# Add ".env" to your .gitignore file.

# ============================================================
